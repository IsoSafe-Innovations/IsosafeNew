# --- Database / infra ---
POSTGRES_USER=isosafe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=isosafe
DATABASE_URL=postgresql+asyncpg://isosafe:change-me@localhost:5432/isosafe
REDIS_URL=redis://localhost:6379/0
HTTP_PORT=80
HTTPS_PORT=443
API_WORKERS=2

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://localhost

# --- Detection thresholds ---
VEHICLE_CONFIDENCE=0.35
PERSON_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.20

# --- Pipeline cadence ---
PROCESS_EVERY_N_FRAMES=3
OCR_EVERY_N_FRAMES=5

# --- Rule defaults ---
STOPPED_VEHICLE_SECONDS=10
LOITER_SECONDS=30
STOPPED_PIXEL_DELTA=15
INCIDENT_COOLDOWN_SECS=30
QUEUE_ZONE_THRESHOLD=5

# --- Capacity ---
MAX_CAMERAS_PER_NODE=64
INFERENCE_WORKERS=2
FRAME_JPEG_QUALITY=70
DASHBOARD_MAX_FPS=10
# 0 = use the video's native FPS for file playback
FILE_PLAYBACK_FPS=0

# --- Retention ---
RETENTION_DETECTIONS_DAYS=90
RETENTION_SNAPSHOTS_DAYS=30

# --- Media / models ---
MEDIA_ROOT=/data/media
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu

# --- Alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@isosafe.local
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=critical
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- AI (optional; leave blank to disable Assistant + Insights) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Security ---
FERNET_KEY=
UPLOAD_MAX_MB=500
