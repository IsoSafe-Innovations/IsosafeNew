# --- Database / infra ---
POSTGRES_USER=isosafe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=isosafe
DATABASE_URL=postgresql+asyncpg://isosafe:change-me@localhost:5432/isosafe
REDIS_URL=redis://localhost:6379/0
HTTP_PORT=80
HTTPS_PORT=443
API_WORKERS=2

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_ADMIN_EMAIL=admin@isosafe.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-after-first-login
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://localhost

# --- Detection thresholds ---
VEHICLE_CONFIDENCE=0.35
PERSON_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.65

# --- Pipeline cadence ---
PROCESS_EVERY_N_FRAMES=3
OCR_EVERY_N_FRAMES=5

# --- Rule defaults ---
STOPPED_VEHICLE_SECONDS=10
LOITER_SECONDS=30
STOPPED_PIXEL_DELTA=15
INCIDENT_COOLDOWN_SECS=30
QUEUE_ZONE_THRESHOLD=5

# --- Capacity ---
MAX_CAMERAS_PER_NODE=64
INFERENCE_WORKERS=1
WORKER_MEMORY_LIMIT_MB=4096
FRAME_JPEG_QUALITY=70
DASHBOARD_MAX_FPS=10
# 0 = use the video's native FPS for file playback
FILE_PLAYBACK_FPS=0

# --- Retention ---
RETENTION_DETECTIONS_DAYS=90
RETENTION_SNAPSHOTS_DAYS=30

# --- Media / models ---
MEDIA_ROOT=/data/media
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu
# Analysis quality options are also editable per camera in Cameras -> Analysis.
YOLO_DETAIL_MODEL=yolov8s.pt
INFERENCE_THREADS=2
INFERENCE_TIMEOUT_SECS=45
MAX_ANALYSIS_FRAME_AGE_SECS=3
# Only sharp, localized plate candidates are read; require repeated agreement.
PLATE_MIN_WIDTH=64
PLATE_MIN_SHARPNESS=60
PLATE_CONSENSUS_READS=3
# Optional: path to a separately validated plate-detection model.
# PLATE_MODEL=/data/models/plate-detector.pt

# --- Alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@isosafe.local
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=critical
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- AI (optional; leave blank to disable Assistant + Insights) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Security ---
FERNET_KEY=
UPLOAD_MAX_MB=500

# --- Object storage (S3 in cloud; MinIO stands in locally) ---
# Leave S3_BUCKET blank to keep v1 local /media behaviour.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_PUT_SECONDS=300
S3_PRESIGN_GET_SECONDS=300

# --- Agent mode (site box; AGENT_MODE=1 also enables the cloud /agent/v1 router) ---
AGENT_MODE=0
CLOUD_URL=
AGENT_TOKEN=
AGENT_LIVE_FPS=2
AGENT_WS_PING_SECONDS=20
AGENT_HEARTBEAT_SECONDS=30
AGENT_ONLINE_SECS=90
AGENT_MAX_MESSAGE_BYTES=1048576
AGENT_INCIDENT_QUEUE_MAX=500
